---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadSourceTracker from '../components/LeadSourceTracker.astro';
import { absoluteUrl, pageUrl, pageGraph, serializeSchema, type SchemaNode, type Breadcrumb } from '../lib/structured-data';

interface Props {
  title?: string;
  description?: string;
  structuredData?: SchemaNode[];
  breadcrumbs?: Breadcrumb[];
  image?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  publishedTime?: string;
  articleSection?: string;
}

const {
  title = 'Eco Tech Group | Rury i konstrukcje stalowe',
  description = 'Rury i konstrukcje stalowe',
  structuredData = [],
  breadcrumbs,
  image,
  imageAlt,
  ogType = 'website',
  publishedTime,
  articleSection
} = Astro.props;

const pageTitle = `${title.trim().replace(/\s*\|\s*Eco\s?Tech Group(?: Sp\. z o\.o\.)?$/i, '')} | Eco Tech Group`;
const pageDescription = description.trim() || `${title.split(' | ')[0].trim()} — Eco Tech Group.`;
const canonicalUrl = pageUrl(Astro.url.pathname);
const socialImage = absoluteUrl(image?.trim() || '/img/main/hero-industrial-pipes.jpg');
const socialImageAlt = imageAlt?.trim() || (image ? title.split(' | ')[0].trim() : 'Rury stalowe w hali Eco Tech Group');

const schema = Astro.response.status < 400 ? pageGraph({
  pathname: Astro.url.pathname, title, description, entities: structuredData, breadcrumbs
}) : null;

const pageTransition = {
  forwards: {
    old: { name: 'page-exit', duration: '180ms', easing: 'ease-out', fillMode: 'both' },
    new: { name: 'page-enter', duration: '360ms', easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fillMode: 'both' }
  },
  backwards: {
    old: { name: 'page-exit', duration: '180ms', easing: 'ease-out', fillMode: 'both' },
    new: { name: 'page-enter', duration: '360ms', easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fillMode: 'both' }
  }
};
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={pageDescription} />
    {Astro.response.status < 400 && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:site_name" content="Eco Tech Group" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && articleSection && <meta property="article:section" content={articleSection} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <meta name="generator" content={Astro.generator} />
    {schema && <script type="application/ld+json" set:html={serializeSchema(schema)} />}
    <meta name="robots" content="noindex" />
    {(Astro.url.pathname === '/' || /^\/aktualnosci\/[^/]+\/?$/.test(Astro.url.pathname)) && (
      <link rel="alternate" type="text/markdown" href={Astro.url.pathname === '/' ? '/index.md' : Astro.url.href} />
    )}
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <LeadSourceTracker />
    <Header />
    <main transition:animate={pageTransition}><slot /></main>
    <Footer />
  </body>
</html>
