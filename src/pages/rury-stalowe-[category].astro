---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const categories = await getCollection('steelPipeCategories');

  return categories.map((category) => ({
    params: { category: category.data.slug },
    props: { category }
  }));
}

interface Props {
  category: CollectionEntry<'steelPipeCategories'>;
}

const { category } = Astro.props;
const { Content } = await render(category);
const products = (await getCollection('steelPipeProducts'))
  .filter((product) => product.data.category === category.data.slug)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`${category.data.title} | Rury stalowe | Eco Tech Group`} description={category.data.description}>
  <article class="pipe-category-page bg-white pt-32 text-ink lg:pt-38">
    <div class="mx-auto max-w-7xl px-5 md:px-8">
      <nav class="flex flex-wrap items-center gap-x-2 gap-y-1 py-6 text-sm text-ink/55" aria-label="Okruszki nawigacyjne">
        <a href="/" class="hover:text-accent-1">Strona główna</a>
        <span aria-hidden="true">/</span>
        <a href="/rury-stalowe" class="hover:text-accent-1">Rury stalowe</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page" class="text-ink/70">{category.data.title}</span>
      </nav>
    </div>

    <div class="mx-auto max-w-7xl px-5 md:px-8">
      <div class="grid lg:grid-cols-[minmax(0,1fr)_23rem] lg:gap-14">
        <section class="min-w-0 pb-16 pt-4 lg:pb-24">
          <h1 class="text-3xl font-semibold leading-tight tracking-[-0.045em] text-[#142b3a] md:text-4xl">{category.data.title}</h1>
          <div class="category-content mt-10 max-w-3xl"><Content /></div>

          <div class="mt-16 flex items-end justify-between gap-6 border-b border-accent-1/15 pb-5">
            <div>
              <p class="eyebrow">Produkty</p>
              <h2 class="mt-2 text-2xl font-semibold tracking-[-0.04em] text-[#142b3a]">Dostępne rury</h2>
            </div>
            <span class="text-sm text-ink/55">{products.length} {products.length === 1 ? 'produkt' : 'produktów'}</span>
          </div>

          {products.length > 0 ? (
            <ul class="mt-6 divide-y divide-ink/10 border-y border-ink/10">
              {products.map((product) => (
                <li>
                  <a href={`/rury-stalowe/${category.data.slug}/${product.data.slug}`} class="group grid items-center gap-2 px-4 py-4 transition-colors hover:bg-mist sm:grid-cols-[10rem_minmax(0,1fr)_auto] sm:gap-6 sm:px-5">
                    <span class="text-xs font-bold uppercase tracking-[0.12em] text-accent-1">{product.data.specification ?? 'Rura stalowa'}</span>
                    <h3 class="text-base font-semibold leading-6 tracking-[-0.02em] text-[#142b3a] group-hover:text-accent-1">{product.data.title}</h3>
                    <span class="hidden text-sm font-semibold text-accent-1 sm:inline">Szczegóły →</span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-6 border border-dashed border-accent-1/20 bg-mist p-6 text-sm leading-6 text-ink/65">Produkty w tej kategorii zostaną wkrótce uzupełnione.</p>
          )}
        </section>

        <aside class="self-stretch bg-[#f3f5f6] px-6 py-10 md:px-10 lg:min-h-[44rem] lg:py-12">
          <form class="mx-auto max-w-sm" aria-describedby="filter-unavailable">
            <h2 class="text-2xl font-semibold tracking-[-0.04em] text-[#142b3a]">Znajdź rurę stalową</h2>
            <p id="filter-unavailable" class="mt-3 text-sm leading-6 text-ink/60">Filtr jest obecnie w przygotowaniu. Skontaktuj się z nami, aby dobrać produkt.</p>
            <fieldset disabled class="mt-8 grid gap-4 disabled:opacity-100">
              <label><span class="sr-only">Średnica</span><select class="pipe-filter-input"><option>Średnica</option></select></label>
              <label><span class="sr-only">Ścianka</span><select class="pipe-filter-input"><option>Ścianka</option></select></label>
              <label><span class="sr-only">Długość</span><select class="pipe-filter-input"><option>Długość</option></select></label>
              <label><span class="sr-only">Gatunek</span><select class="pipe-filter-input"><option>Gatunek</option></select></label>
              <label><span class="sr-only">Norma</span><select class="pipe-filter-input"><option>Norma</option></select></label>
            </fieldset>
            <button type="button" disabled class="mt-5 bg-accent-1 px-7 py-3.5 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:opacity-65">Filtruj</button>
          </form>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style is:global>
  body:has(.pipe-category-page) > header { background: #fff; color: var(--color-ink); }
  body:has(.pipe-category-page) > header img { filter: brightness(0) saturate(100%); }
  body:has(.pipe-category-page) > header a { color: var(--color-ink); }
  body:has(.pipe-category-page) > header a.bg-accent-1 { color: #fff; }
  body:has(.pipe-category-page) > header nav { border-color: color-mix(in srgb, var(--color-ink) 15%, transparent); }
  body:has(.pipe-category-page) > header svg path[fill] { fill: var(--color-ink) !important; }
</style>

<style>
  .category-content { color: #586d85; }
  .category-content :global(p),
  .category-content :global(li) {
    font-size: clamp(0.9375rem, 0.91rem + 0.15vw, 1rem);
    line-height: 1.7;
  }
  .category-content :global(p + p) { margin-top: 1.25rem; }
  .category-content :global(h2) {
    margin-top: 3.25rem;
    color: #142b3a;
    font-size: clamp(1.7rem, 1.45rem + 1vw, 2rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.035em;
  }
  .category-content :global(h3) {
    margin-top: 2.25rem;
    color: #142b3a;
    font-size: clamp(1.25rem, 1.12rem + 0.6vw, 1.5rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }
  .category-content :global(ul) {
    margin-top: 1.5rem;
    list-style: circle;
    padding-left: 1.25rem;
  }
  .category-content :global(li + li) { margin-top: 0.45rem; }
  .category-content :global(figure) { margin-top: 1.75rem; }
  .category-content :global(figure img) { height: 100%; width: 100%; object-fit: cover; }
  .category-content :global(table) { margin-top: 1.75rem; width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .category-content :global(th),
  .category-content :global(td) { border: 1px solid rgb(20 43 58 / 16%); padding: 0.85rem; text-align: left; vertical-align: top; }
  .category-content :global(th) { background: #edf3eb; color: #142b3a; font-weight: 600; }
  .category-content :global(details) { margin-top: 0.75rem; border: 1px solid rgb(20 43 58 / 16%); background: #fff; padding: 1rem 1.25rem; }
  .category-content :global(summary) { cursor: pointer; color: #142b3a; font-weight: 600; }
  .pipe-filter-input {
    width: 100%;
    appearance: auto;
    border: 1px solid rgb(20 43 58 / 20%);
    border-radius: 0.125rem;
    background: #fff;
    padding: 0.9rem 1rem;
    color: #142b3a;
    font-size: 0.95rem;
  }
  .pipe-filter-input:disabled { cursor: not-allowed; color: rgb(20 43 58 / 65%); -webkit-text-fill-color: rgb(20 43 58 / 65%); }
</style>
