---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

const deliveries = (await getCollection('delivery')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Dostawa rur stalowych | Eco Tech Group" description="Dostawa rur stalowych do miast w całej Polsce.">
  <PageHero title="Dostawa rur stalowych" />

  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <div class="max-w-2xl">
      <p class="eyebrow">Dostawa w całej Polsce</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-[-0.04em] md:text-4xl">Rury stalowe z dostawą do Twojego miasta</h2>
      <p class="mt-5 text-lg leading-8 text-ink/70">Wybierz miasto, aby przejść do informacji o dostawie rur stalowych.</p>
    </div>

    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {deliveries.map((delivery, index) => (
        <a href={`/dostawa-rur-stalowych/${delivery.data.slug}`} class="group flex min-h-52 flex-col justify-between border border-accent-1/15 bg-white p-6 transition-colors hover:border-accent-1 hover:bg-mist">
          <div>
            <p class="text-xs font-bold tracking-[0.15em] text-sun">{String(index + 1).padStart(2, '0')}</p>
            <h2 class="mt-8 text-2xl font-semibold tracking-[-0.04em]">{delivery.data.city}</h2>
            <p class="mt-3 text-sm leading-6 text-ink/65">Dostawa rur stalowych do miasta {delivery.data.city} i okolic.</p>
          </div>
          <span class="mt-7 text-sm font-semibold text-accent-1 group-hover:text-accent-1/75">Sprawdź dostawę <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
