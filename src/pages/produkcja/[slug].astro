---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

export const prerender = true;

export async function getStaticPaths() {
  const productionItems = await getCollection('production');

  return productionItems.map((item) => ({
    params: { slug: item.data.slug },
    props: { item }
  }));
}

interface Props {
  item: CollectionEntry<'production'>;
}

const { item } = Astro.props;
const { Content } = await render(item);
---

<BaseLayout title={`${item.data.title} | Eco Tech Group`} description={item.data.description}>
  <article class="production-page">
    <PageHero title={item.data.title} breadcrumbs={[{ label: 'Produkcja', href: '/produkcja' }]} image={item.data.image} imageAlt={item.data.imageAlt ?? item.data.title} />

    <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 lg:py-24">
      <div class="production-content max-w-7xl">
        <Content />
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .production-content { color: #586d85; }

  .production-content :global(p),
  .production-content :global(li) {
    font-size: clamp(0.9375rem, 0.91rem + 0.15vw, 1rem);
    line-height: 1.7;
  }

  .production-content :global(p + p) { margin-top: 1.25rem; }
  .production-content :global(a) { color: var(--color-accent-1); font-weight: 600; text-decoration: underline; text-underline-offset: 0.16em; }
  .production-content :global(a:hover) { color: var(--color-ink); }
  .production-content :global(strong) { color: #142b3a; font-weight: 600; }

  .production-content :global(h2) {
    margin-top: 3.25rem;
    color: #142b3a;
    font-size: clamp(1.7rem, 1.45rem + 1vw, 2rem);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.035em;
  }

  .production-content :global(h3) {
    margin-top: 2.25rem;
    color: #142b3a;
    font-size: clamp(1.25rem, 1.12rem + 0.6vw, 1.5rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.025em;
  }

  .production-content :global(h4) { margin-top: 1.75rem; color: #142b3a; font-weight: 600; }
  .production-content :global(.thin-text) { font-weight: 400; }
  .production-content :global(ul) { margin-top: 1.5rem; list-style: circle; padding-left: 1.25rem; }
  .production-content :global(li + li) { margin-top: 0.45rem; }
  .production-content :global(hr) { margin: 1.5rem 0; border: 0; border-top: 1px solid rgb(20 43 58 / 14%); }
  .production-content :global(.et-line-yellow) { width: 4rem; border-color: var(--color-sun); border-top-width: 2px; }

  .production-content :global(.wp-block-columns) {
    display: grid;
    gap: 1.5rem;
    margin: 2.5rem 0;
  }

  .production-content :global(.wp-block-column) { min-width: 0; }
  .production-content :global(figure) { margin: 2rem 0; overflow: hidden; }
  .production-content :global(figure a) { display: block; height: 100%; }
  .production-content :global(figure img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .production-content :global(.wp-block-columns figure) { margin: 0; aspect-ratio: 16 / 9; }
  .production-content :global(.wp-block-gallery) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .production-content :global(.wp-block-gallery > figure) { margin: 0; aspect-ratio: 16 / 9; }

  .production-content :global(table) { margin-top: 1.75rem; width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .production-content :global(th),
  .production-content :global(td) { border: 1px solid rgb(20 43 58 / 16%); padding: 0.85rem; text-align: left; vertical-align: top; }
  .production-content :global(th) { background: #edf3eb; color: #142b3a; font-weight: 600; }

  @media (min-width: 48rem) {
    .production-content :global(.wp-block-columns) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 47.99rem) {
    .production-content :global(.wp-block-columns.reverse-mob > .wp-block-column:first-child) { order: 2; }
    .production-content :global(.wp-block-columns.reverse-mob > .wp-block-column:nth-child(2)) { order: 1; }
  }
</style>
