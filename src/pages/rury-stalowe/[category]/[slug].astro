---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';

export async function getStaticPaths() {
  const products = await getCollection('steelPipeProducts');

  return products.map((product) => ({
    params: { category: product.data.category, slug: product.data.slug },
    props: { product }
  }));
}

interface Props {
  product: CollectionEntry<'steelPipeProducts'>;
}

const { product } = Astro.props;
const categories = await getCollection('steelPipeCategories');
const category = categories.find((item) => item.data.slug === product.data.category);
const { Content } = await render(product);
const breadcrumbs = [
  { label: 'Rury stalowe', href: '/rury-stalowe' },
  { label: category?.data.title ?? 'Kategoria', href: `/rury-stalowe-${product.data.category}` }
];
---

<BaseLayout title={`${product.data.title} | Eco Tech Group`} description={product.data.description}>
  <article>
    <PageHero title={product.data.title} breadcrumbs={breadcrumbs} />

    <section class="mx-auto grid max-w-7xl gap-12 px-5 py-16 md:grid-cols-[minmax(0,1fr)_18rem] md:px-8 md:py-24">
      <div class="max-w-3xl text-lg leading-8 text-ink/75 [&_h2]:mt-12 [&_h2]:text-3xl [&_h2]:font-semibold [&_h2]:tracking-[-0.04em] [&_p]:mt-6 [&_ul]:mt-6 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6"><Content /></div>
      <aside class="h-fit border-t-2 border-accent-1 bg-mist p-6">
        <p class="text-sm font-semibold">Zapytaj o produkt</p>
        <p class="mt-3 text-sm leading-6 text-ink/65">Skontaktuj się z nami, aby potwierdzić dostępność i otrzymać wycenę.</p>
        <a href="/kontakt" class="mt-6 inline-flex bg-accent-1 px-5 py-3 text-sm font-semibold text-white hover:bg-accent-1/85">Wyślij zapytanie</a>
      </aside>
    </section>
  </article>
</BaseLayout>
