---
import { getCollection } from 'astro:content';

export const prerender = false;

const products = await getCollection('steelPipeProducts');
const product = products.find(({ data }) =>
  data.category === Astro.params.category && data.slug === Astro.params.slug
);

if (!product) return Astro.rewrite('/404');

return Astro.redirect(`/${product.data.slug}/`, 301);
---
