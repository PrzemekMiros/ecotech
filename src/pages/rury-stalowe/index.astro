---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SteelPipesOverview from '../../components/SteelPipesOverview.astro';
import SteelPipeFilters from '../../components/SteelPipeFilters.astro';

const categories = (await getCollection('steelPipeCategories')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Rury stalowe | Eco Tech Group"
  description="Katalog rur stalowych: rury ze szwem, bez szwu, izolowane, dwudzielne i używane."
>
  <PageHero title="Rury stalowe" />

  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-10">
    <div class="min-w-0">
    <div class="mb-10 max-w-5xl space-y-4 text-base leading-7 text-ink/75">
      <p>Nasza oferta obejmuje szeroki asortyment rur stalowych do zastosowań konstrukcyjnych, ciśnieniowych i gazowych. Dobieramy produkty do wymagań projektu, właściwej normy i warunków pracy.</p>
      <p>Współpracujemy ze sprawdzonymi dostawcami. Oferujemy rury ze szwem wzdłużnym i spiralnym, bez szwu, w izolacji, dwudzielne, zwijane z blachy oraz używane. Wybierz kategorię, aby sprawdzić dostępne wyroby.</p>
    </div>
    <nav class="flex max-w-3xl flex-wrap gap-2.5" aria-label="Kategorie rur stalowych">
      {categories.map((category) => {
        const label = category.data.title.replace(/^Rury stalowe\s+/i, '');
        return (
          <a href={`/rury-stalowe-${category.data.slug}`} class="inline-flex items-center rounded-md border border-accent-1 bg-white px-3 py-2 text-base leading-6 text-accent-1 transition-colors hover:bg-accent-1 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-1">
            {label.charAt(0).toUpperCase() + label.slice(1)}
          </a>
        );
      })}
    </nav>
    <SteelPipesOverview />
    </div>
    <SteelPipeFilters />
    </div>
  </section>
</BaseLayout>
