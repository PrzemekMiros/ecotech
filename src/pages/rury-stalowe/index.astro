---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SteelPipesOverview from '../../components/SteelPipesOverview.astro';
import SteelPipeFilters from '../../components/SteelPipeFilters.astro';
import { readPipeFilters, matchesPipeFilters } from '../../lib/pipe-filters.mjs';
import { itemListSchema } from '../../lib/structured-data';

const categories = (await getCollection('steelPipeCategories')).sort((a, b) => a.data.order - b.data.order);
export const prerender = false;
const filters = readPipeFilters(Astro.url.searchParams);
const hasFilters = Object.values(filters).some(Boolean);
const results = hasFilters ? (await getCollection('steelPipeProducts'))
  .filter(product => matchesPipeFilters(product, filters))
  .sort((a, b) => a.data.order - b.data.order) : [];
if (hasFilters && results.length === 0) Astro.response.status = 404;
---

<BaseLayout
  title="Rury stalowe | Eco Tech Group"
  description="Katalog rur stalowych: rury ze szwem, bez szwu, izolowane, dwudzielne i używane."
  structuredData={[hasFilters
    ? itemListSchema('Wyniki filtrowania rur stalowych', results.map(({ data }) => ({ name: data.title, path: `/${data.slug}/` })))
    : itemListSchema('Kategorie rur stalowych', categories.map(({ data }) => ({ name: data.title, path: `/rury-stalowe-${data.slug}/` })))]}
>
  <PageHero title="Rury stalowe" />

  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <div class="grid items-start gap-8 lg:grid-cols-[minmax(0,1fr)_19rem] lg:gap-10">
    <div class="min-w-0">
    {hasFilters && (
      <section id="wyniki" aria-labelledby="search-results-title" class="mb-12 scroll-mt-8">
        <h2 id="search-results-title" tabindex="-1" class="text-2xl font-semibold text-accent-1">{filters.q ? `Wyniki wyszukiwania: ${filters.q}` : 'Wyniki filtrowania'}</h2>
        <p class="mt-3" role="status">Znaleziono produktów: {results.length}.</p>
        {results.length ? (
          <>
            <ul id="filtered-products" class="mt-5 divide-y divide-ink/10 border-y border-ink/10">
              {results.map(({ data }, index) => (
                <li hidden={index >= 10}><a class="block px-4 py-4 font-semibold text-accent-1 hover:bg-mist focus-visible:outline-2" href={`/${data.slug}/`}>{data.title}</a></li>
              ))}
            </ul>
            {results.length > 10 && <button type="button" data-more-filtered aria-controls="filtered-products" class="mt-6 bg-accent-1 px-6 py-3 font-semibold text-white hover:bg-ink">Zobacz więcej</button>}
          </>
        ) : <p class="mt-3">Nie znaleziono rur spełniających wybrane kryteria. Zmień parametry, wyczyść filtry lub <a href="/kontakt/" class="text-accent-1 underline">zapytaj o dobór rury</a>.</p>}
      </section>
    )}

    <div class="mb-10 max-w-5xl space-y-4 text-base leading-7 text-ink/75">
      <p>Nasza oferta obejmuje szeroki asortyment rur stalowych do zastosowań konstrukcyjnych, ciśnieniowych i gazowych. Dobieramy produkty do wymagań projektu, właściwej normy i warunków pracy.</p>
      <p>Współpracujemy ze sprawdzonymi dostawcami. Oferujemy rury ze szwem wzdłużnym i spiralnym, bez szwu, w izolacji, dwudzielne, zwijane z blachy oraz używane. Wybierz kategorię, aby sprawdzić dostępne wyroby.</p>
    </div>
    <nav class="flex max-w-3xl flex-wrap gap-2.5" aria-label="Kategorie rur stalowych">
      {categories.map((category) => {
        const label = category.data.title.replace(/^Rury stalowe\s+/i, '');
        return (
          <a href={`/rury-stalowe-${category.data.slug}/`} class="inline-flex items-center rounded-md border border-accent-1 bg-white px-3 py-2 text-base leading-6 text-accent-1 transition-colors hover:bg-accent-1 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-1">
            {label.charAt(0).toUpperCase() + label.slice(1)}
          </a>
        );
      })}
    </nav>
    <SteelPipesOverview />
    </div>
    <SteelPipeFilters selected={filters} class="order-first lg:order-none" />
    </div>
  </section>
</BaseLayout>

<script>
  function initFilteredResults() {
    const list = document.getElementById('filtered-products');
    const button = document.querySelector<HTMLButtonElement>('[data-more-filtered]');
    if (!list || !button || button.dataset.initialized) return;
    button.dataset.initialized = 'true';
    button.addEventListener('click', () => {
      const next = Array.from(list.querySelectorAll<HTMLLIElement>('li[hidden]')).slice(0, 10);
      next.forEach(item => { item.hidden = false; });
      next[0]?.querySelector('a')?.focus({ preventScroll: true });
      button.hidden = !list.querySelector('li[hidden]');
    });
  }
  initFilteredResults();
  document.addEventListener('astro:page-load', initFilteredResults);
</script>
<noscript>
  <style>
    #filtered-products > li[hidden] { display: list-item !important; }
    [data-more-filtered] { display: none !important; }
  </style>
</noscript>
