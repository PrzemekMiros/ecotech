---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import OfferTile from '../../components/OfferTile.astro';
import { itemListSchema } from '../../lib/structured-data';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Usługi | Eco Tech Group"
  description="Usługi związane z obróbką, produkcją i konserwacją rur stalowych."
  structuredData={[itemListSchema('Usługi', services.map(({ data }) => ({ name: data.title, path: `/uslugi/${data.slug}` })))]}
>
  <PageHero title="Usługi" />

  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <div class="grid gap-x-8 gap-y-12 md:grid-cols-2">
      {services.map((service) => (
        <OfferTile href={'/uslugi/' + service.data.slug} title={service.data.title} image={service.data.image} imageAlt={service.data.imageAlt} />
      ))}
    </div>
  </section>
</BaseLayout>
