---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout
  title="Kalkulator wagi rur stalowych | Eco Tech Group"
  description="Oblicz orientacyjną wagę rury stalowej na metr oraz całkowitą wagę zamówienia."
>
  <PageHero title="Kalkulator wagi rur stalowych" />

  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <div class="max-w-3xl">
      <p class="eyebrow">Narzędzia techniczne</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-[-0.04em] md:text-4xl">Oblicz orientacyjną wagę rur stalowych</h2>
      <p class="mt-5 text-lg leading-8 text-ink/70">Wprowadź wymiary rury, jej długość oraz liczbę sztuk. Kalkulator poda masę jednego metra i szacunkową wagę całego zamówienia.</p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:gap-12">
      <form id="pipe-calculator" class="border border-accent-1/15 bg-white p-6 sm:p-8" novalidate>
        <div class="flex items-start justify-between gap-6 border-b border-ink/10 pb-6">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-1">Parametry rury</p>
            <p class="mt-2 text-sm leading-6 text-ink/60">Wszystkie wymiary podaj w milimetrach.</p>
          </div>
          <span class="grid size-11 shrink-0 place-items-center bg-mist text-xl font-semibold text-accent-1" aria-hidden="true">Ø</span>
        </div>

        <div class="mt-7 grid gap-5 sm:grid-cols-2">
          <label class="block text-sm font-semibold text-ink" for="outer-diameter">
            Średnica zewnętrzna
            <span class="mt-2 flex items-center border border-ink/15 bg-sand focus-within:border-accent-1 focus-within:ring-1 focus-within:ring-accent-1">
              <input id="outer-diameter" name="outerDiameter" type="number" inputmode="decimal" min="0.1" step="0.1" value="114.3" class="min-w-0 flex-1 bg-transparent px-4 py-3 outline-none" required />
              <span class="pr-4 text-sm font-medium text-ink/50">mm</span>
            </span>
          </label>
          <label class="block text-sm font-semibold text-ink" for="wall-thickness">
            Grubość ścianki
            <span class="mt-2 flex items-center border border-ink/15 bg-sand focus-within:border-accent-1 focus-within:ring-1 focus-within:ring-accent-1">
              <input id="wall-thickness" name="wallThickness" type="number" inputmode="decimal" min="0.1" step="0.1" value="6.3" class="min-w-0 flex-1 bg-transparent px-4 py-3 outline-none" required />
              <span class="pr-4 text-sm font-medium text-ink/50">mm</span>
            </span>
          </label>
          <label class="block text-sm font-semibold text-ink" for="pipe-length">
            Długość jednej rury
            <span class="mt-2 flex items-center border border-ink/15 bg-sand focus-within:border-accent-1 focus-within:ring-1 focus-within:ring-accent-1">
              <input id="pipe-length" name="pipeLength" type="number" inputmode="decimal" min="0.01" step="0.01" value="6" class="min-w-0 flex-1 bg-transparent px-4 py-3 outline-none" required />
              <span class="pr-4 text-sm font-medium text-ink/50">m</span>
            </span>
          </label>
          <label class="block text-sm font-semibold text-ink" for="quantity">
            Liczba rur
            <span class="mt-2 flex items-center border border-ink/15 bg-sand focus-within:border-accent-1 focus-within:ring-1 focus-within:ring-accent-1">
              <input id="quantity" name="quantity" type="number" inputmode="numeric" min="1" step="1" value="1" class="min-w-0 flex-1 bg-transparent px-4 py-3 outline-none" required />
              <span class="pr-4 text-sm font-medium text-ink/50">szt.</span>
            </span>
          </label>
        </div>

        <p id="calculator-error" class="mt-5 hidden border-l-2 border-sun bg-sand px-4 py-3 text-sm leading-6 text-ink/70" role="alert"></p>

        <div class="mt-8 flex flex-wrap items-center gap-4 border-t border-ink/10 pt-6">
          <button type="submit" class="bg-accent-1 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-1/85">Oblicz wagę</button>
          <button type="reset" class="px-2 py-3 text-sm font-semibold text-accent-1 hover:text-ink">Przywróć wartości</button>
        </div>
      </form>

      <aside class="bg-accent-1 p-6 text-white sm:p-8" aria-live="polite">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-white/65">Wynik obliczeń</p>
        <div class="mt-8 border-b border-white/20 pb-6">
          <p class="text-sm text-white/65">Masa 1 metra rury</p>
          <p class="mt-2 text-4xl font-semibold tracking-[-0.05em]"><span data-result="per-meter">16,95</span> <span class="text-xl text-white/65">kg/m</span></p>
        </div>
        <div class="border-b border-white/20 py-6">
          <p class="text-sm text-white/65">Masa jednej rury</p>
          <p class="mt-2 text-3xl font-semibold tracking-[-0.05em]"><span data-result="per-pipe">101,71</span> <span class="text-lg text-white/65">kg</span></p>
        </div>
        <div class="pt-6">
          <p class="text-sm text-white/65">Łączna masa</p>
          <p class="mt-2 text-4xl font-semibold tracking-[-0.05em]"><span data-result="total">101,71</span> <span class="text-xl text-white/65">kg</span></p>
        </div>
        <p class="mt-8 border-t border-white/20 pt-5 text-xs leading-5 text-white/60">Wynik ma charakter orientacyjny i został wyliczony dla gęstości stali 7 850 kg/m³. Rzeczywista masa może różnić się zależnie od gatunku stali, tolerancji wymiarowych i powłok.</p>
      </aside>
    </div>

    <div class="mt-16 grid gap-8 border-t border-accent-1/15 pt-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]">
      <div>
        <p class="eyebrow">Jak liczymy wagę?</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.04em]">Wzór dla rur stalowych</h2>
        <p class="mt-5 text-base leading-7 text-ink/70">Masa jednego metra rury jest obliczana na podstawie średnicy zewnętrznej i grubości ścianki. Kalkulator uwzględnia standardową gęstość stali wynoszącą 7 850 kg/m³.</p>
        <p class="mt-6 inline-block bg-mist px-5 py-4 font-semibold text-ink">kg/m = 0,02466 × s × (D − s)</p>
        <p class="mt-3 text-sm leading-6 text-ink/55">D — średnica zewnętrzna [mm], s — grubość ścianki [mm]</p>
      </div>
      <div class="border border-accent-1/15 bg-white p-6">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-1">Potrzebujesz dokładnej wyceny?</p>
        <h2 class="mt-3 text-2xl font-semibold tracking-[-0.04em]">Zapytaj o dostępność rur</h2>
        <p class="mt-4 text-sm leading-6 text-ink/65">Pomożemy dobrać parametry, długość oraz rodzaj rury do wymagań Twojej inwestycji.</p>
        <a href="/kontakt" class="mt-7 inline-flex bg-accent-1 px-5 py-3 text-sm font-semibold text-white hover:bg-accent-1/85">Wyślij zapytanie <span class="ml-2" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const formatWeight = new Intl.NumberFormat('pl-PL', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  function initialiseCalculator() {
    const form = document.querySelector<HTMLFormElement>('#pipe-calculator');
    if (!form || form.dataset.initialised) return;
    form.dataset.initialised = 'true';

    const outerDiameter = form.elements.namedItem('outerDiameter') as HTMLInputElement;
    const wallThickness = form.elements.namedItem('wallThickness') as HTMLInputElement;
    const pipeLength = form.elements.namedItem('pipeLength') as HTMLInputElement;
    const quantity = form.elements.namedItem('quantity') as HTMLInputElement;
    const error = document.querySelector<HTMLElement>('#calculator-error');
    const result = {
      perMeter: document.querySelector<HTMLElement>('[data-result="per-meter"]'),
      perPipe: document.querySelector<HTMLElement>('[data-result="per-pipe"]'),
      total: document.querySelector<HTMLElement>('[data-result="total"]')
    };

    const getValue = (input: HTMLInputElement) => Number.parseFloat(input.value.replace(',', '.'));

    function calculate() {
      const diameter = getValue(outerDiameter);
      const thickness = getValue(wallThickness);
      const length = getValue(pipeLength);
      const pipes = getValue(quantity);

      if (!Number.isFinite(diameter) || !Number.isFinite(thickness) || !Number.isFinite(length) || !Number.isFinite(pipes) || diameter <= 0 || thickness <= 0 || length <= 0 || pipes <= 0) {
        if (error) {
          error.textContent = 'Wprowadź dodatnie wartości we wszystkich polach.';
          error.hidden = false;
        }
        return;
      }

      if (thickness * 2 >= diameter) {
        if (error) {
          error.textContent = 'Grubość ścianki musi być mniejsza niż połowa średnicy zewnętrznej.';
          error.hidden = false;
        }
        return;
      }

      const perMeter = 0.02466 * thickness * (diameter - thickness);
      const perPipe = perMeter * length;
      const total = perPipe * Math.round(pipes);

      if (error) error.hidden = true;
      if (result.perMeter) result.perMeter.textContent = formatWeight.format(perMeter);
      if (result.perPipe) result.perPipe.textContent = formatWeight.format(perPipe);
      if (result.total) result.total.textContent = formatWeight.format(total);
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      calculate();
    });
    form.addEventListener('input', calculate);
    form.addEventListener('reset', () => window.setTimeout(calculate));
    calculate();
  }

  document.addEventListener('astro:page-load', initialiseCalculator);
  initialiseCalculator();
</script>
