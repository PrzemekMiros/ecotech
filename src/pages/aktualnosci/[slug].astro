---
import { getCollection } from 'astro:content';
import { Picture } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { absoluteUrl, pageUrl, organizationId } from '../../lib/structured-data';

import { prepareArticle } from '../../lib/article-content';
import { articleAuthor as author } from '../../data/article-author';
import { isExcludedFromIndexing } from '../../lib/indexing.mjs';

export const prerender = false;

const posts = await getCollection('news');
const post = posts.find((entry) => entry.data.slug === Astro.params.slug);
if (!post) return Astro.rewrite('/404');
if (!post.rendered?.html) throw new Error(`Missing rendered article: ${post.data.slug}`);
const article = prepareArticle(post.rendered.html);
const modifiedDate = post.data.dateModified ?? post.data.pubDate;
const glossary = post.data.glossary;
const keyTakeaways = post.data.keyTakeaways ?? [];
const howTo = post.data.howTo;
const canonical = pageUrl(Astro.url.pathname);
const formatDate = new Intl.DateTimeFormat('pl-PL', { day: '2-digit', month: 'long', year: 'numeric' });
const relatedPosts = posts
  .filter((entry) => entry.id !== post.id && !isExcludedFromIndexing(`/aktualnosci/${entry.data.slug}/`))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const faq = post.data.faq ?? [];
const faqSchema = faq.length > 0 ? {
  '@type': 'FAQPage',
  mainEntity: faq.map((entry) => ({
    '@type': 'Question',
    name: entry.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: entry.answer
    }
  }))
} : null;
const glossarySchema = glossary.length ? {
  '@type': 'DefinedTermSet', '@id': `${canonical}#article-glossary-heading`,
  name: `Słownik: ${post.data.title}`, inLanguage: 'pl-PL',
  hasDefinedTerm: glossary.map((entry, index) => ({
    '@type': 'DefinedTerm', '@id': `${canonical}#termin-${index + 1}`,
    name: entry.term, description: entry.definition,
    inDefinedTermSet: { '@id': `${canonical}#article-glossary-heading` }
  }))
} : null;
const howToSchema = howTo ? {
  '@type': 'HowTo', '@id': `${canonical}#article-howto-heading`,
  name: howTo.name, inLanguage: 'pl-PL',
  step: howTo.steps.map((step, index) => ({
    '@type': 'HowToStep', position: index + 1, name: step.name, text: step.text,
    url: `${canonical}#krok-${index + 1}`
  }))
} : null;
const toc = [
  ...article.toc,
  ...(howTo ? [{ id: 'article-howto-heading', text: howTo.name, level: 2 }] : []),
  ...(glossary.length ? [{ id: 'article-glossary-heading', text: 'Słownik pojęć', level: 2 }] : []),
  ...(faq.length ? [{ id: 'article-faq-heading', text: 'Pytania i odpowiedzi', level: 2 }] : [])
];
---

<BaseLayout title={`${post.data.title} | Eco Tech Group`} description={post.data.description} image={post.data.image} imageAlt={post.data.imageAlt} ogType="article" publishedTime={post.data.pubDate.toISOString()} modifiedTime={modifiedDate.toISOString()} articleSection={post.data.category} structuredData={[{
  '@type': 'BlogPosting', headline: post.data.title, description: post.data.description,
  datePublished: post.data.pubDate.toISOString(), dateModified: modifiedDate.toISOString(), inLanguage: 'pl-PL',
  image: absoluteUrl(post.data.image ?? '/img/main/hero-industrial-pipes.jpg'),
  author: { '@type': 'Person', '@id': 'https://ecotechgroup.pl/#adam-iwanowski', name: author.name, jobTitle: author.role, worksFor: { '@id': organizationId }, ...(author.sameAs.length ? { sameAs: author.sameAs } : {}) },
  publisher: { '@id': organizationId },
  mainEntityOfPage: { '@id': `${pageUrl(Astro.url.pathname)}#webpage` }
}, ...[faqSchema, glossarySchema, howToSchema].filter((item) => item !== null)]}>
  <article class="overflow-hidden">
    <section class="relative isolate min-h-[15rem] bg-[#030b20] text-white">
      <img src="/img/main/hala-rury-stalowe-wynajem.jpg" width="1024" height="683" loading="eager" fetchpriority="high" alt="Rury stalowe w hali Eco Tech Group" class="absolute inset-0 -z-20 h-full w-full object-cover object-center" />
      <div class="absolute inset-0 -z-10 bg-[#061126]/75"></div>
      <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[#061126]/90 via-[#061126]/48 to-transparent"></div>

      <div class="mx-auto flex min-h-[15rem] max-w-7xl items-end px-5 pb-28 pt-36 md:px-8 md:pb-32">
        <div>
          <nav class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-white/70" aria-label="Okruszki nawigacyjne">
            <a href="/" class="hover:text-white">Strona główna</a><span aria-hidden="true" class="text-white/35">/</span>
            <a href="/aktualnosci" class="hover:text-white">Aktualności</a><span aria-hidden="true" class="text-white/35">/</span>
            <span aria-current="page" class="text-white">Artykuł</span>
          </nav>
        </div>
      </div>
    </section>

    <section class="relative z-10 mx-auto -mt-16 max-w-7xl px-5 pb-16 md:-mt-24 md:px-8 md:pb-24">
      <div class="bg-white shadow-[0_18px_55px_rgba(6,17,38,0.04)]">
        <div class="grid gap-12 p-6 sm:p-10 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-16 lg:p-14">
          <div class="min-w-0">

            <figure class="mb-8">
              <Picture
                src={post.data.image ?? '/img/main/hero-industrial-pipes.jpg'}
                alt={post.data.imageAlt ?? post.data.title}
                width={1600} height={900}
                widths={[320, 480, 640, 960, 1280, 1600]}
                sizes="(min-width: 1280px) 768px, (min-width: 1024px) calc(100vw - 512px), (min-width: 768px) calc(100vw - 144px), (min-width: 640px) calc(100vw - 120px), calc(100vw - 88px)"
                formats={['avif', 'webp']} fallbackFormat="jpg"
                class="aspect-[16/9] w-full object-cover"
                loading="eager" fetchpriority="high"
              />
            </figure>

            <div class="flex flex-wrap items-center gap-3 text-xs font-bold uppercase tracking-[0.16em] text-accent-1">
              <span>{post.data.category}</span><span class="size-1 rounded-full bg-sun"></span>
              <time datetime={post.data.pubDate.toISOString()}>Publikacja: {formatDate.format(post.data.pubDate)}</time>
              <time datetime={modifiedDate.toISOString()} data-date-modified>Aktualizacja redakcyjna: {formatDate.format(modifiedDate)}</time>
            </div>
            <h1 class="mt-6 max-w-4xl text-2xl font-semibold leading-[1.1] tracking-[-0.045em] text-ink sm:text-3xl md:text-4xl">{post.data.title}</h1>
            {post.data.archiveNote && <p class="mt-5 border-l-4 border-sun bg-mist p-4 text-sm leading-6 text-ink/75">{post.data.archiveNote}</p>}
            {keyTakeaways.length > 0 && <aside class="mt-6 max-w-3xl border border-accent-1/20 bg-mist/45 p-5 sm:p-6" aria-label="Kluczowe wnioski">
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-1">Kluczowe wnioski</p>
              <ul class="mt-3 list-disc space-y-2 pl-5 text-base leading-7 text-ink/75">{keyTakeaways.map(fact => <li>{fact}</li>)}</ul>
            </aside>}
            <div class="mt-8 flex flex-wrap items-center gap-4 border-y border-ink/10 py-4 text-sm text-ink/60">
              <span class="font-semibold text-ink">Eco Tech Group</span><span aria-hidden="true" class="size-1 rounded-full bg-sun"></span><span>Szacowany czas czytania: 3 min</span>
            </div>

            {toc.length > 0 && <nav id="article-toc" class="mt-10 border border-ink/10 bg-mist/45 p-5" aria-label="Spis treści">
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-1">Spis treści</p>
              <ul id="article-toc-list" class="mt-4 space-y-2 text-sm leading-6 text-ink/75">
                {toc.map(heading => <li class:list={{ 'ml-4 border-l border-ink/10 pl-4': heading.level === 3 }}>
                  <a href={`#${heading.id}`} class="transition-colors hover:text-accent-1">{heading.text}</a>
                </li>)}
              </ul>
            </nav>}

            <div class="article-content mt-10 max-w-3xl text-base leading-8 text-ink/75 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:leading-tight [&_h2]:tracking-[-0.035em] [&_h3]:mt-7 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:leading-snug [&_p]:mt-6 [&_ul]:mt-6 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6 [&_ol]:mt-6 [&_ol]:list-decimal [&_ol]:space-y-2 [&_ol]:pl-6 [&_figure]:mt-8 [&_figure_img]:w-full [&_figure_img]:object-cover [&_table]:mt-8 [&_table]:w-full [&_table]:border-collapse [&_table]:text-sm [&_td]:border [&_td]:border-ink/15 [&_td]:p-3 [&_th]:border [&_th]:border-ink/15 [&_th]:bg-mist [&_th]:p-3 [&_a]:font-semibold [&_a]:text-accent-1 [&_a]:underline [&_a]:underline-offset-4" set:html={article.html} />

            {howTo && <section class="mt-12 border-t border-ink/10 pt-8" aria-labelledby="article-howto-heading">
              <h2 id="article-howto-heading" class="text-2xl font-semibold text-ink">{howTo.name}</h2>
              <ol class="mt-6 list-decimal space-y-5 pl-6">
                {howTo.steps.map((step, index) => <li id={`krok-${index + 1}`}>
                  <h3 class="font-semibold text-ink">{step.name}</h3>
                  <p class="mt-2 text-sm leading-7 text-ink/70">{step.text}</p>
                </li>)}
              </ol>
            </section>}

            {glossary.length > 0 && <section class="mt-12 border-t border-ink/10 pt-8" aria-labelledby="article-glossary-heading">
              <h2 id="article-glossary-heading" class="text-2xl font-semibold leading-tight tracking-[-0.035em] text-ink">Słownik pojęć</h2>
              <p class="mt-3 max-w-3xl text-sm leading-6 text-ink/65">Najważniejsze pojęcia związane z tematyką artykułu.</p>
              <dl class="mt-6 grid gap-x-8 gap-y-5 sm:grid-cols-2">
                {glossary.map((entry, index) => (
                  <div id={`termin-${index + 1}`} class="border-l-2 border-sun pl-4">
                    <dt class="font-semibold text-ink">{entry.term}</dt>
                    <dd class="mt-1 text-sm leading-6 text-ink/70">{entry.definition}</dd>
                  </div>
                ))}
              </dl>
            </section>}

            {faq.length > 0 && (
              <section class="mt-12 border-t border-ink/10 pt-8" aria-labelledby="article-faq-heading">
                <h2 id="article-faq-heading" class="text-2xl font-semibold leading-tight tracking-[-0.035em] text-ink">Pytania i odpowiedzi</h2>
                <p class="mt-3 max-w-3xl text-sm leading-6 text-ink/65">Najczęstsze pytania podsumowujące najważniejsze informacje z artykułu.</p>
                <div class="mt-6 divide-y divide-ink/10 border-y border-ink/10">
                  {faq.map((entry) => (
                    <details class="group py-5 first:pt-4 last:pb-4">
                      <summary class="flex cursor-pointer list-none items-start justify-between gap-6 font-semibold text-ink marker:hidden">
                        <span>{entry.question}</span>
                        <span class="shrink-0 text-xl font-normal leading-none text-accent-1 transition-transform group-open:rotate-45" aria-hidden="true">+</span>
                      </summary>
                      <p class="mt-3 max-w-3xl text-sm leading-7 text-ink/70">{entry.answer}</p>
                    </details>
                  ))}
                </div>
              </section>
            )}

            <div class="mt-10 flex items-center gap-4 border-y border-ink/10 py-4" aria-label={`Autor: ${author.name}`}>
              <div class="flex size-11 shrink-0 items-center justify-center rounded-full bg-accent-1 text-sm font-semibold text-white" aria-hidden="true">AI</div>
              <div>
                <p class="text-sm font-semibold text-ink">{author.name}</p>
                <p class="mt-0.5 text-sm text-ink/60">{author.role}</p>
              </div>
            </div>

            <div class="mt-12 border-t border-ink/10 pt-7">
              <p class="text-sm font-semibold text-ink">Udostępnij artykuł</p>
              <div class="mt-4 flex flex-wrap gap-3">
                <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 border border-ink/15 px-4 py-2.5 text-sm font-semibold text-ink hover:border-accent-1 hover:text-accent-1">LinkedIn <span aria-hidden="true">↗</span></a>
                <a href={`mailto:?subject=${encodeURIComponent(post.data.title)}&body=${encodeURIComponent(Astro.url.href)}`} class="inline-flex items-center gap-2 border border-ink/15 px-4 py-2.5 text-sm font-semibold text-ink hover:border-accent-1 hover:text-accent-1">Wyślij e-mailem <span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </div>

          <aside class="h-fit lg:sticky lg:top-8">
            <div class="border border-ink/10 p-5">
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-accent-1">Najnowsze wpisy</p>
              <div class="mt-4 divide-y divide-ink/10">
                {relatedPosts.map((related) => (
                  <a href={`/aktualnosci/${related.data.slug}`} class="group block py-4 first:pt-0">
                    <p class="text-xs font-bold uppercase tracking-[0.14em] text-accent-1/65">{formatDate.format(related.data.pubDate)}</p>
                    <h2 class="mt-2 text-sm font-semibold leading-5 text-ink transition-colors group-hover:text-accent-1">{related.data.title}</h2>
                  </a>
                ))}
              </div>
              <a href="/aktualnosci" class="mt-5 inline-flex text-sm font-semibold text-accent-1 hover:text-ink">Zobacz wszystkie <span class="ml-2" aria-hidden="true">→</span></a>
            </div>
            <div class="mt-5 bg-accent-1 p-6 text-white">
              <p class="text-xs font-bold uppercase tracking-[0.16em] text-white/65">Potrzebujesz wsparcia?</p>
              <h2 class="mt-3 text-xl font-semibold leading-6 tracking-[-0.03em]">Porozmawiajmy o Twojej inwestycji.</h2>
              <p class="mt-3 text-sm leading-6 text-white/75">Dobierzemy rozwiązanie dopasowane do specyfiki projektu.</p>
              <a href="/kontakt" class="mt-6 inline-flex bg-white px-4 py-3 text-sm font-semibold text-accent-1 hover:bg-sand">Skontaktuj się <span class="ml-2" aria-hidden="true">→</span></a>
            </div>
          </aside>
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .article-content :global(h2), .article-content :global(h3), [id^="article-"], [id^="krok-"], [id^="termin-"] { scroll-margin-top: 8rem; }
</style>
