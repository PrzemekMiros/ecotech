---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

export async function getStaticPaths() {
  const jobs = await getCollection('jobs');

  return jobs.map((job) => ({
    params: { slug: job.data.slug },
    props: { job }
  }));
}

interface Props {
  job: CollectionEntry<'jobs'>;
}

const { job } = Astro.props;
const { Content } = await render(job);
const formatDate = new Intl.DateTimeFormat('pl-PL', { day: '2-digit', month: 'long', year: 'numeric' });
---

<BaseLayout title={`${job.data.title} | Praca | Eco Tech Group`} description={job.data.description}>
  <article>
    <PageHero title={job.data.title} breadcrumbs={[{ label: 'Praca', href: '/praca' }]} />

    <section class="mx-auto grid max-w-7xl gap-12 px-5 py-16 md:grid-cols-[minmax(0,1fr)_18rem] md:px-8 md:py-24">
      <div class="max-w-3xl">
        {(job.data.location || job.data.pubDate) && (
          <div class="flex flex-wrap items-center gap-3 border-b border-accent-1/15 pb-6 text-sm font-semibold text-accent-1">
            {job.data.location && <span>{job.data.location}</span>}
            {job.data.location && job.data.pubDate && <span class="size-1 rounded-full bg-sun"></span>}
            {job.data.pubDate && <time datetime={job.data.pubDate.toISOString()}>{formatDate.format(job.data.pubDate)}</time>}
          </div>
        )}
        <div class="mt-8 text-lg leading-8 text-ink/75 [&_h2]:mt-12 [&_h2]:text-3xl [&_h2]:font-semibold [&_h2]:leading-tight [&_h2]:tracking-[-0.04em] [&_h2:first-child]:mt-0 [&_p]:mt-6 [&_ul]:mt-6 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-6 [&_hr]:my-10 [&_hr]:border-accent-1/15 [&_.job-details]:my-8 [&_.job-details]:grid [&_.job-details]:gap-4 md:[&_.job-details]:grid-cols-2 [&_.job-details_p]:m-0 [&_.job-details_p]:border-l-2 [&_.job-details_p]:border-sun [&_.job-details_p]:bg-mist [&_.job-details_p]:p-5 [&_.job-details_strong]:block [&_.job-details_strong]:text-sm [&_.job-details_strong]:font-semibold [&_.job-details_strong]:text-accent-1 [&_.job-details_span]:mt-1 [&_.job-details_span]:block"><Content /></div>
      </div>
      <aside class="h-fit border-t-2 border-accent-1 bg-mist p-6">
        <p class="text-sm font-semibold">Zainteresowała Cię oferta?</p>
        <p class="mt-3 text-sm leading-6 text-ink/65">Skontaktuj się z nami, aby dowiedzieć się więcej o stanowisku i procesie rekrutacji.</p>
        <a href="/kontakt" class="mt-6 inline-flex bg-accent-1 px-5 py-3 text-sm font-semibold text-white hover:bg-accent-1/85">Skontaktuj się</a>
      </aside>
    </section>
  </article>
</BaseLayout>
