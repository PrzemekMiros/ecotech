---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const sections = [
  ['Katalogi produktów', 'Materiały dotyczące oferty rur stalowych, produkcji i usług.'],
  ['Dokumenty techniczne', 'Karty techniczne, deklaracje oraz dokumentacja produktowa.'],
  ['Certyfikaty', 'Dokumenty potwierdzające standardy jakości i zgodność materiałów.'],
  ['Formularze', 'Dokumenty pomocne przy składaniu zapytań i realizacji zamówień.']
];
---

<BaseLayout title="Do pobrania | Eco Tech Group" description="Dokumenty, katalogi i materiały techniczne Eco Tech Group.">
  <PageHero title="Do pobrania" />

  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <div class="max-w-2xl">
      <p class="eyebrow">Centrum materiałów</p>
      <h2 class="mt-3 text-3xl font-semibold tracking-[-0.04em] md:text-4xl">Dokumenty i materiały techniczne</h2>
      <p class="mt-5 text-lg leading-8 text-ink/70">W tej sekcji będą dostępne aktualne katalogi, karty techniczne, certyfikaty oraz formularze.</p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {sections.map(([title, description], index) => (
        <article class="border border-accent-1/15 bg-white p-6">
          <p class="text-xs font-bold tracking-[0.15em] text-sun">{String(index + 1).padStart(2, '0')}</p>
          <h3 class="mt-8 text-2xl font-semibold tracking-[-0.04em]">{title}</h3>
          <p class="mt-3 text-sm leading-6 text-ink/65">{description}</p>
          <p class="mt-7 text-sm font-semibold text-ink/45">Pliki w przygotowaniu</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
