---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const catalogs = [
  { title: 'Katalog Eco Tech Group 2026', language: 'Wersja polska', lang: 'pl', href: '/pdf/EcoTech_katalog_PL_2026.pdf', size: '4,55 MB' },
  { title: 'Eco Tech Group Catalogue 2026', language: 'Wersja angielska', lang: 'en', href: '/pdf/EcoTech_katalog_2026_EN.pdf', size: '3,83 MB' }
];
---

<BaseLayout title="Do pobrania | Eco Tech Group" description="Dokumenty, katalogi i materiały techniczne Eco Tech Group.">
  <PageHero title="Do pobrania" />

  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <div class="max-w-2xl">
      <p class="eyebrow">Materiały</p>
      <h2 class="mt-3 text-xl font-semibold tracking-[-0.04em] md:text-2xl">Katalogi PDF do pobrania</h2>
      <p class="mt-5 text-ink/70">Poznaj ofertę Eco Tech Group. Otwórz katalog lub pobierz go w wybranej wersji językowej.</p>
    </div>

    <div class="mt-12 grid gap-4 md:grid-cols-2">
      {catalogs.map((catalog) => (
        <article class="flex flex-col border border-accent-1/15 bg-white p-6">
          <p class="text-xs font-bold uppercase tracking-[0.15em] text-accent-1">PDF · {catalog.size}</p>
          <h3 lang={catalog.lang} class="mt-8 text-2xl font-semibold tracking-[-0.04em]">{catalog.title}</h3>
          <p class="mt-3 text-sm leading-6 text-ink/65">{catalog.language}</p>
          <div class="mt-auto flex flex-wrap items-center gap-5 pt-7">
            <a href={catalog.href} download class="inline-flex bg-accent-1 px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-ink" aria-label={`Pobierz PDF — ${catalog.language}`}>Pobierz PDF ↓</a>
            <a href={catalog.href} target="_blank" rel="noopener noreferrer" hreflang={catalog.lang} class="text-sm font-semibold text-accent-1 underline underline-offset-4 hover:text-ink" aria-label={`Otwórz katalog — ${catalog.language} (nowa karta)`}>Otwórz katalog ↗</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
