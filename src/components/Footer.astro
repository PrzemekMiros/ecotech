---
const quickLinks = [
  { href: '/rury-stalowe', label: 'Rury stalowe' },
  { href: '/uslugi', label: 'Usługi' },
  { href: '/produkcja', label: 'Produkcja' },
  { href: '/dostawa-rur-stalowych', label: 'Dostawa rur' },
  { href: '/kontakt', label: 'Kontakt' }
];

const companyLinks = [
  { href: '/o-nas', label: 'O firmie' },
  { href: '/aktualnosci', label: 'Aktualności' },
  { href: '/do-pobrania', label: 'Do pobrania' },
  { href: '/praca', label: 'Praca' },
  { href: '/kalkulator-wagi-rur-stalowych', label: 'Kalkulator wagi rur' }
];
---

<footer class="border-t border-white/10 bg-[#07111e] text-white">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="grid border-x border-white/10 md:grid-cols-2 lg:grid-cols-4">
      <section class="border-b border-white/10 px-6 py-10 md:border-r lg:border-b-0 lg:px-8 lg:py-12" aria-labelledby="footer-links">
        <h2 id="footer-links" class="text-sm font-semibold uppercase tracking-[0.03em] text-white/55">Szybkie linki</h2>
        <ul class="mt-6 space-y-3 text-sm leading-5 text-white/75">
          {quickLinks.map((link) => <li><a href={link.href} class="transition-colors hover:text-sun">{link.label}</a></li>)}
        </ul>
      </section>

      <section class="border-b border-white/10 px-6 py-10 md:px-8 lg:border-b-0 lg:border-r lg:py-12" aria-labelledby="footer-company">
        <h2 id="footer-company" class="text-sm font-semibold uppercase tracking-[0.03em] text-white/55">Eco Tech Group</h2>
        <ul class="mt-6 space-y-3 text-sm leading-5 text-white/75">
          {companyLinks.map((link) => <li><a href={link.href} class="transition-colors hover:text-sun">{link.label}</a></li>)}
        </ul>
      </section>

      <section class="border-b border-white/10 px-6 py-10 md:border-r md:px-8 lg:border-b-0 lg:py-12" aria-labelledby="footer-contact">
        <h2 id="footer-contact" class="text-sm font-semibold uppercase tracking-[0.03em] text-white/55">Kontakt</h2>
        <div class="mt-6 space-y-3 text-sm leading-6 text-white/75">
          <a href="tel:+48508299077" class="block transition-colors hover:text-sun">+48 508 299 077</a>
          <a href="mailto:sprzedaz@ecotechgroup.pl" class="block break-words transition-colors hover:text-sun">sprzedaz@ecotechgroup.pl</a>
          <p class="pt-2 text-white/50">Poniedziałek–piątek<br />8:00–16:00</p>
        </div>
      </section>

      <section class="px-6 py-10 md:px-8 lg:py-12" aria-labelledby="footer-address">
        <h2 id="footer-address" class="text-sm font-semibold uppercase tracking-[0.03em] text-white/55">Siedziba firmy</h2>
        <address class="mt-6 text-sm leading-6 not-italic text-white/75">
          Eco Tech Group Sp. z o.o.<br />
          ul. Mieczysława Pożaryskiego 32<br />
          04-703 Warszawa
        </address>
        <a href="/kontakt" class="mt-4 inline-flex text-sm font-semibold text-sun transition-colors hover:text-white">Zobacz mapę →</a>
      </section>
    </div>

    <div class="grid border-x border-white/10 border-t border-white/10 md:grid-cols-[1fr_auto]">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-4 px-6 py-5 md:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.03em] text-white/55">Obserwuj nas</p>
        <div class="flex items-center gap-3 text-white/70" aria-label="Kanały społecznościowe Eco Tech Group">
          <span class="grid size-8 place-items-center border border-white/20 text-xs font-bold" aria-label="LinkedIn">in</span>
          <span class="grid size-8 place-items-center border border-white/20" aria-label="YouTube">
            <svg viewBox="0 0 24 24" class="size-4 fill-current" aria-hidden="true"><path d="M21.6 7.2a2.9 2.9 0 0 0-2-2C17.8 4.7 12 4.7 12 4.7s-5.8 0-7.6.5a2.9 2.9 0 0 0-2 2A30.1 30.1 0 0 0 2 12a30.1 30.1 0 0 0 .4 4.8 2.9 2.9 0 0 0 2 2c1.8.5 7.6.5 7.6.5s5.8 0 7.6-.5a2.9 2.9 0 0 0 2-2A30.1 30.1 0 0 0 22 12a30.1 30.1 0 0 0-.4-4.8ZM10.1 15.1V8.9l5.3 3.1-5.3 3.1Z" /></svg>
          </span>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-white/10 px-6 py-5 text-sm text-white/50 md:border-l md:border-t-0 md:px-8">
        <a href="/polityka-prywatnosci" class="hover:text-white">Polityka prywatności</a>
        <a href="/kontakt" class="hover:text-white">Pliki cookies</a>
      </div>
    </div>

    <div class="grid gap-7 border-x border-white/10 border-t border-white/10 px-6 py-9 md:grid-cols-[minmax(14rem,0.8fr)_minmax(0,1.2fr)] md:items-center md:px-8 md:py-10">
      <a href="/" class="w-fit" aria-label="Eco Tech Group — strona główna">
        <img src="/img/logo/EcoTech_Logo_white.png" alt="Eco Tech Group" class="h-9 w-auto" />
      </a>
      <p class="max-w-2xl text-sm leading-6 text-white/45 md:justify-self-end">Eco Tech Group dostarcza rury stalowe, konstrukcje i rozwiązania dla projektów przemysłowych oraz infrastrukturalnych.</p>
    </div>
  </div>
</footer>
