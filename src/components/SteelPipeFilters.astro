---
import { getCollection } from 'astro:content';
import { pipeFilterOptions, readPipeFilters, normalizePipeValue } from '../lib/pipe-filters.mjs';

interface Props { category?: string; selected?: Record<string, string>; class?: string }

const [products, categories] = await Promise.all([
  getCollection('steelPipeProducts'),
  getCollection('steelPipeCategories')
]);
const { category = '', selected = readPipeFilters(Astro.url.searchParams), class: className } = Astro.props;
const values = { ...selected, type: category || selected.type };
const availableProducts = values.type ? products.filter(product => product.data.category === values.type) : products;
const filters = pipeFilterOptions(availableProducts);
const resetUrl = category ? `/rury-stalowe-${category}/` : '/rury-stalowe/';
---

<aside class:list={['h-fit rounded-md border border-accent-1/20 bg-white p-5 lg:sticky lg:top-8 lg:p-6', className]} aria-labelledby="pipe-filters-heading">
  <p id="pipe-filters-heading" class="text-xl font-semibold text-ink">Znajdź rurę stalową</p>
  <form method="get" action="/rury-stalowe/#wyniki" class="mt-6 space-y-5" aria-label="Filtry rur stalowych" data-pipe-filters>
    {values.q && <input type="hidden" name="q" value={values.q} />}
    {category ? <input type="hidden" name="type" value={category} /> : <div>
      <label for="pipe-type" class="sr-only">Rodzaj</label>
      <select id="pipe-type" name="type">
        <option value="">Rodzaj</option>
        {values.type && !categories.some(item => item.data.slug === values.type) && <option value={values.type} selected>{values.type} — brak w ofercie</option>}
        {categories.sort((a, b) => a.data.order - b.data.order).map(category => (
          <option value={category.data.slug} selected={values.type === category.data.slug}>{category.data.title.replace(/^Rury stalowe\s+/i, '')}</option>
        ))}
      </select>
    </div>}
    {filters.map(filter => (
      <div>
        <label for={`pipe-${filter.name}`} class="sr-only">{filter.label}{filter.unit && ` [${filter.unit}]`}</label>
        <select id={`pipe-${filter.name}`} name={filter.name}>
          <option value="">{filter.label}{filter.unit && ` [${filter.unit}]`}</option>
          {values[filter.name] && !filter.values.includes(normalizePipeValue(values[filter.name], Boolean(filter.unit))) && (
            <option value={values[filter.name]} selected>{values[filter.name]} — brak w ofercie</option>
          )}
          {filter.values.map(value => <option value={value} selected={normalizePipeValue(values[filter.name] ?? '', Boolean(filter.unit)) === value}>{filter.unit ? value.replace('.', ',') : value}</option>)}
        </select>
      </div>
    ))}
    <div class="space-y-3 border-t border-ink/10 pt-5">
      <button type="submit" class="w-full rounded border border-accent-1 bg-accent-1 px-4 py-3 text-sm font-semibold text-white transition-colors hover:bg-accent-1/85">Filtruj</button>
      <a href={resetUrl} class="block w-full rounded border border-ink/20 px-4 py-3 text-center text-sm font-semibold text-ink/70 transition-colors hover:bg-mist">Wyczyść filtry</a>
    </div>
  </form>
</aside>

<script>
  document.addEventListener('submit', (event) => {
    const form = event.target;
    if (!(form instanceof HTMLFormElement) || !form.matches('[data-pipe-filters]')) return;
    event.preventDefault();
    const url = new URL(form.action);
    for (const [name, value] of new FormData(form)) {
      if (typeof value === 'string' && value.trim()) url.searchParams.set(name, value.trim());
    }
    window.location.assign(url.href);
  });
</script>

<style>
  select {
    width: 100%; min-height: 48px; min-width: 0; border: 1px solid #d8dde6; border-radius: .25rem;
    background-color: white; padding: .75rem .5rem; color: var(--color-ink); font-size: .875rem;
  }
  select:focus-visible { outline: 2px solid var(--color-accent-1); outline-offset: 2px; }
</style>
