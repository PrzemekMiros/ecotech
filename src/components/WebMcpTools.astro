<script>
  import { agentTools } from '../lib/agent-tools';

  type WebMcpDocument = Document & {
    readonly modelContext?: { registerTool(tool: typeof agentTools[number]): void | Promise<void> };
    __ecotechWebMcpRegistered?: boolean;
  };

  const webMcpDocument = document as WebMcpDocument;
  const registry = webMcpDocument.modelContext;

  if (!webMcpDocument.__ecotechWebMcpRegistered && typeof registry?.registerTool === 'function') {
    webMcpDocument.__ecotechWebMcpRegistered = true;
    for (const tool of agentTools) {
      void Promise.resolve().then(() => registry.registerTool(tool))
        .catch((error: unknown) => console.warn('WebMCP tool registration failed.', error));
    }
  }
</script>
