---
interface Props {
  number: string;
  title: string;
  description: string;
  href?: string;
}
const { number, title, description, href = '/oferta' } = Astro.props;
---

<a href={href} class="group flex min-h-64 flex-col justify-between border border-accent-1/15 bg-white p-6 hover:border-accent-1 hover:bg-mist">
  <div>
    <p class="text-xs font-bold tracking-[0.15em] text-sun">{number}</p>
    <h3 class="mt-10 text-2xl font-semibold tracking-[-0.04em]">{title}</h3>
    <p class="mt-3 text-sm leading-6 text-ink/65">{description}</p>
  </div>
  <span class="mt-7 text-sm font-semibold text-accent-1 group-hover:text-accent-1/75">Poznaj rozwiązanie <span aria-hidden="true">→</span></span>
</a>
