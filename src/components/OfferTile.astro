---
interface Props {
  href: string;
  title: string;
  image?: string;
  imageAlt?: string;
}
const { href, title, image, imageAlt } = Astro.props;
---

<a href={href} class="offer-tile group flex h-full flex-col focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-1">
  <div class="aspect-[1.9/1] overflow-hidden bg-mist">
    <img src={image ?? '/img/main/hero-industrial-pipes.jpg'} alt={imageAlt ?? title} class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" loading="lazy" />
  </div>
  <div class="relative -mt-10 ml-4 grid flex-1 grid-cols-[minmax(0,1fr)_auto] items-stretch sm:ml-7">
    <div class="flex min-h-36 items-center bg-accent-1 px-5 py-7 text-white transition-colors group-hover:bg-accent-1/90 sm:px-7">
      <h2 class="text-base font-semibold uppercase leading-snug tracking-tight lg:text-lg">{title}</h2>
    </div>
    <span class="mt-10 flex items-center justify-center gap-2 px-3 py-5 text-xs font-semibold uppercase text-ink sm:px-5 sm:text-sm">
      <span>Zobacz więcej</span>
      <span class="text-2xl font-normal text-accent-1 transition-transform group-hover:translate-x-1" aria-hidden="true">&gt;</span>
    </span>
  </div>
</a>

<style>
  @media (max-width: 380px) {
    .offer-tile > div:last-child { grid-template-columns: minmax(0, 1fr); }
    .offer-tile > div:last-child > span { margin-top: 0; justify-content: flex-end; }
  }
</style>
