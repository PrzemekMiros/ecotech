---
import BaseLayout from '../layouts/BaseLayout.astro';
import OfferCard from '../components/OfferCard.astro';
import PageHero from '../components/PageHero.astro';
const offers = [
  ['01', 'Gospodarka wodna', 'Rozwiązania w zakresie oczyszczania ścieków, retencji i ponownego wykorzystania wody.'],
  ['02', 'Systemy rurowe', 'Komponenty dla instalacji przemysłowych i wodno-kanalizacyjnych.'],
  ['03', 'Separacja i filtracja', 'Urządzenia do efektywnego oddzielania zanieczyszczeń i ochrony instalacji.'],
  ['04', 'Zbiorniki i retencja', 'Systemy magazynowania oraz kontrolowanego zagospodarowania wód opadowych.'],
  ['05', 'Produkty specjalistyczne', 'Rozwiązania dobierane do wymagań konkretnej inwestycji.'],
  ['06', 'Wsparcie projektu', 'Konsultacja techniczna, wyceny i pomoc na etapie realizacji.']
];
---
<BaseLayout title="Oferta | Eco Tech Group">
  <PageHero title="Oferta" />
  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24"><div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">{offers.map(([number, title, description]) => <OfferCard number={number} title={title} description={description} />)}</div></section>
</BaseLayout>
