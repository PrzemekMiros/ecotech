---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

const productionItems = (await getCollection('production')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Produkcja | Eco Tech Group" description="Produkcja elementów i konstrukcji stalowych na potrzeby inwestycji przemysłowych oraz infrastrukturalnych.">
  <PageHero title="Produkcja" />

  <section class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-24">
    <div class="grid gap-4 md:grid-cols-2">
      {productionItems.map((item, index) => (
        <a href={`/produkcja/${item.data.slug}`} class="group flex min-h-64 flex-col overflow-hidden border border-accent-1/15 bg-white transition-colors hover:border-accent-1 hover:bg-mist">
          {item.data.image && <img src={item.data.image} alt={item.data.imageAlt ?? item.data.title} class="aspect-[16/8.5] w-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy" />}
          <div class="flex flex-1 flex-col justify-between p-6">
            <div>
            <p class="text-xs font-bold tracking-[0.15em] text-sun">{String(index + 1).padStart(2, '0')}</p>
            <h2 class="mt-5 text-2xl font-semibold tracking-[-0.04em]">{item.data.title}</h2>
            <p class="mt-3 max-w-xl text-sm leading-6 text-ink/65">{item.data.description}</p>
            </div>
            <span class="mt-7 text-sm font-semibold text-accent-1 group-hover:text-accent-1/75">Poznaj zakres produkcji <span aria-hidden="true">→</span></span>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
