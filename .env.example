# Dane pobrane w panelu Firmao: Firma -> Ustawienia -> API.
# Nie dodawaj pliku .env do repozytorium ani nie ustawiaj prefiksu PUBLIC_.
FIRMAO_ORGANIZATION_ID=twoj-identyfikator-organizacji
FIRMAO_API_LOGIN=twoj-login-api
FIRMAO_API_PASSWORD=twoje-haslo-api
MAINTENANCE_MODE=false

# Sanity: local zachowuje treści z repozytorium; sanity pobiera opublikowane dokumenty.
CONTENT_SOURCE=local
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Tylko dla prywatnego datasetu: token z prawem odczytu, bez prefiksu PUBLIC_/SANITY_STUDIO_.
SANITY_API_READ_TOKEN=
